# Application
CONTEXT_COMPILER_APP_ENV=development
CONTEXT_COMPILER_LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API directly.
CONTEXT_COMPILER_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
CONTEXT_COMPILER_CORS_ALLOW_CREDENTIALS=false

# Source profiler
CONTEXT_COMPILER_PROFILE_MAX_UPLOAD_BYTES=104857600
CONTEXT_COMPILER_PROFILE_EXAMPLE_LIMIT=5
CONTEXT_COMPILER_PROFILE_DISTINCT_LIMIT=10000
CONTEXT_COMPILER_PROFILE_EXAMPLE_STRING_LENGTH=128
CONTEXT_COMPILER_PROFILE_UPLOAD_CHUNK_BYTES=1048576

# Provider-neutral structured LLM generation (OpenAI-compatible endpoint)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_STRUCTURED_OUTPUT_MODE=json_object
LLM_MAX_OUTPUT_TOKENS=2500
LLM_TEMPERATURE=0
LLM_TOTAL_GENERATION_TIMEOUT_SECONDS=600

# Instrumentation contract uploads and bounded context
CONTEXT_COMPILER_CONTRACT_SPEC_MAX_UPLOAD_BYTES=1048576
CONTEXT_COMPILER_CONTRACT_CONTEXT_MAX_CHARS=8000

# ClickHouse (no credentials are committed)
CONTEXT_COMPILER_CLICKHOUSE_HOST=localhost
CONTEXT_COMPILER_CLICKHOUSE_PORT=8123
CONTEXT_COMPILER_CLICKHOUSE_SECURE=false
CONTEXT_COMPILER_CLICKHOUSE_USERNAME=
CONTEXT_COMPILER_CLICKHOUSE_PASSWORD=
CONTEXT_COMPILER_CLICKHOUSE_DATABASE=default
CONTEXT_COMPILER_CLICKHOUSE_METADATA_DATABASE=compiler_meta
CONTEXT_COMPILER_CLICKHOUSE_CONNECT_TIMEOUT_SECONDS=5
CONTEXT_COMPILER_CLICKHOUSE_QUERY_TIMEOUT_SECONDS=10
CONTEXT_COMPILER_BASE_CONTEXT_PATH=docs/base_context.md

# Langfuse is optional. It stays disabled until both keys are present.
CONTEXT_COMPILER_LANGFUSE_ENABLED=false
CONTEXT_COMPILER_LANGFUSE_PUBLIC_KEY=
CONTEXT_COMPILER_LANGFUSE_SECRET_KEY=
CONTEXT_COMPILER_LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Mandatory recommendation release boundary in production
CONTEXT_COMPILER_RECOMMENDATION_EVALUATOR_URL=http://127.0.0.1:4319/v1/recommendations/evaluate
CONTEXT_COMPILER_RECOMMENDATION_EVALUATOR_AUTH_TOKEN=
CONTEXT_COMPILER_RECOMMENDATION_MAX_EVIDENCE_AGE_MS=86400000
OBSERVABILITY_PORT=4319
OBSERVABILITY_AUTH_TOKEN=
SERVICE_VERSION=0.1.0
RELEASE=local
