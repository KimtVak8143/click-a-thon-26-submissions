{
  "name": "context-compiler-observability",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production AI observability, provenance, and evaluation framework for Context Compiler",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": { ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" } },
  "files": ["dist", "migrations", "docs/AI_OBSERVABILITY_ARCHITECTURE.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "example": "npm run build && node dist/examples/observable-recommendation.js",
    "start:observability": "node --env-file=.env dist/src/agents/server.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@clickhouse/client": "1.23.1",
    "@langfuse/client": "5.10.0",
    "@langfuse/otel": "5.10.0",
    "@langfuse/tracing": "5.10.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
