# Local backend origin. On Vercel, replace this with the public Railway backend origin.
VITE_COMPILER_API_URL=http://localhost:8000

DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_PASSWORD_RESET=false
OPENAI_API_KEY=user_provided
ANTHROPIC_API_KEY=user_provided
GOOGLE_KEY=user_provided
MEILI_MASTER_KEY=replace-with-a-long-random-value
CREDS_KEY=replace-with-32-byte-hex-key
CREDS_IV=replace-with-16-byte-hex-iv
JWT_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value

# ClickHouse MCP server (read-only chat access to the same ClickHouse Cloud service
# the backend deploys tables into). Same values as the backend's CONTEXT_COMPILER_
# CLICKHOUSE_* settings, just without that prefix and under a distinct MCP_ name so
# this container's write-access default (off) can never be confused with the
# backend's own (separate) credential usage.
MCP_CLICKHOUSE_HOST=
MCP_CLICKHOUSE_PORT=8443
MCP_CLICKHOUSE_USER=
MCP_CLICKHOUSE_PASSWORD=
MCP_CLICKHOUSE_SECURE=true
MCP_CLICKHOUSE_DATABASE=
# No auth token here: the mcp-clickhouse container runs with
# CLICKHOUSE_MCP_AUTH_DISABLED=true (see compose.yaml) because LibreChat's MCP
# client misreads that server's static-bearer-token 401 response as a permanent
# OAuth requirement. Local/demo only — don't expose port 8001 beyond your own
# machine.
